# Copy this file to .env.local and fill in your own OpenAI-compatible endpoint.
# Do NOT commit .env.local or any real API key.

# Base URL or full /chat/completions endpoint are both accepted.
# Examples:
#   https://api.openai.com/v1
#   https://your-provider.example/v1/chat/completions
SOCIAL_COMMENT_LLM_ENDPOINT=""

# Required for --analyzer llm. Keep this secret.
SOCIAL_COMMENT_LLM_API_KEY=""

# Example values: gpt-4o-mini, qwen-plus, deepseek-chat, or your provider's model name.
SOCIAL_COMMENT_LLM_MODEL="gpt-4o-mini"
